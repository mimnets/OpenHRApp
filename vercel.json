{
  "rewrites": [
    { "source": "/db-migrate", "destination": "/db-migrate.html" },
    { "source": "/((?!assets/|sitemap\\.xml|robots\\.txt|manifest\\.json|feed\\.xml|sw\\.js|registerSW\\.js|workbox-.*\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
